# Sao chép thành .env (không commit). xAI: dùng key này HOẶC OAuth đã lưu trong agent/auth.json.
XAI_API_KEY=
COMMANDCODE_API_KEY=
# Thư mục agent (để trống = <thư mục mth>/agent)
MTH_AGENT_DIR=
# Tên cũ CODER_* (vd CODER_AGENT_DIR, CODER_WORKDIR) vẫn được nhận nhưng đã lỗi thời:
# mth in cảnh báo một lần rồi dùng giá trị đó; hãy đổi sang MTH_*.
